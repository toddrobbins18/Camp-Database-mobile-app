{
  "expo": {
    "name": "The Nest",
    "slug": "datacamp-mobile",
    "scheme": "datacampmobile",
    "version": "1.0.15",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.thenest.camp.unlisted",
      "buildNumber": "41",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "The Nest uses the camera to take photos and videos for camp messages.",
        "NSMicrophoneUsageDescription": "The Nest uses the microphone for voice and video messages.",
        "NSPhotoLibraryUsageDescription": "The Nest uses your photo library to attach pictures and videos to messages."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.datacampmobile",
      "versionCode": 5
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-notifications",
      "expo-sqlite",
      "expo-updates",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "The Nest uses your location to show live bus position on your route while you choose to share it.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The Nest uses your photo library to attach pictures and videos to messages.",
          "cameraPermission": "The Nest uses the camera to take photos and videos for messages.",
          "microphonePermission": "The Nest uses the microphone for voice and video messages."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "440ab51c-ee2a-44d4-97bf-52e6798b43ec"
      }
    },
    "owner": "ansaralyh",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/440ab51c-ee2a-44d4-97bf-52e6798b43ec",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
