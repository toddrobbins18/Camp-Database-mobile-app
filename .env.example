# Supabase (use your new project as main backend)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SUPABASE_RESET_REDIRECT=datacampmobile://reset-password

# Optional: if your app loads VITE_* env (e.g. via a script), these work too
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
# VITE_SUPABASE_PROJECT_ID=your-project-ref

# Optional: source project settings for one-time export scripts
# LOVABLE_SUPABASE_URL=https://your-lovable-project.supabase.co
# LOVABLE_SUPABASE_SERVICE_ROLE_KEY=your-lovable-service-role-key
# LOVABLE_COMPANY_ID=uuid-of-company-to-export
# LOVABLE_COMPANY_SLUG=tyler-hill-camp

# Optional: target project settings for import sync script
# TARGET_SUPABASE_URL=https://your-target-project.supabase.co
# TARGET_SUPABASE_SERVICE_ROLE_KEY=your-target-service-role-key
# LOVABLE_EXPORT_PATH=exports/lovable-auth-export-YYYY-MM-DDTHH-mm-ss-sssZ.json





